{
  "name": "dsh-project-session-store",
  "version": "0.1.0",
  "description": "DSH 2.x plugin: keep each project's session logs inside the project directory (.dsh/sessions/) instead of the central ~/.dsh/sessions | DSH 插件:把每个项目的会话日志保存在项目目录(.dsh/sessions/)下",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "persistence",
    "project-local"
  ],
  "homepage": "https://github.com/Afiredream/dsh-project-session-store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Afiredream/dsh-project-session-store.git"
  },
  "bugs": {
    "url": "https://github.com/Afiredream/dsh-project-session-store/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-format": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-format-catalog": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.4"
  }
}
